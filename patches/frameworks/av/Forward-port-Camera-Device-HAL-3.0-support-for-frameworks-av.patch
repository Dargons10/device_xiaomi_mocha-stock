+status_t Camera3Device::HalInterface::getDeviceVersion(/*out*/uint32_t* deviceVersion) {
+    ATRACE_NAME("CameraHal::getDeviceVersion");
+    if (!valid()) return INVALID_OPERATION;
+    status_t res = OK;
+
+    uint32_t version = mHidlSession->getDeviceVersion();
+    if (!version) {
+        ALOGE("%s: Transaction error, version: %x", __FUNCTION__, version);
+        res = DEAD_OBJECT;
+    } else {
+        *deviceVersion = version;
+    }
+
+    return res;
+}
