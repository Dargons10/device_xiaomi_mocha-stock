+status_t Camera3Device::HalInterface::registerStreamBuffers(camera3_stream_buffer_set* bufferSet) {
+    ATRACE_NAME("CameraHal::registerStreamBuffers");
+    if (!valid()) return INVALID_OPERATION;
+    status_t res = OK;
+
+    // Convert stream buffer set to HIDL
+    StreamBufferSet hidlBufferSet;
+    hidlBufferSet.buffers.resize(bufferSet->num_buffers);
+
+    Stream &dst = hidlBufferSet.stream; //hidl stream is not a pointer
+    Camera3Stream *cam3stream = Camera3Stream::cast(bufferSet->stream);
+    cam3stream->setBufferFreedListener(this);
+    int streamId = cam3stream->getId();
+    StreamType streamType;
+    switch (bufferSet->stream->stream_type) {
+        case CAMERA3_STREAM_OUTPUT:
+            streamType = StreamType::OUTPUT;
+            break;
+        case CAMERA3_STREAM_INPUT:
+            streamType = StreamType::INPUT;
+            break;
+        default:
+            //TODO: BIDIRECTIONAL is not supported.
+            ALOGE("%s: Stream %d: Unsupported stream type %d",
+                    __FUNCTION__, streamId, bufferSet->stream->stream_type);
+            return BAD_VALUE;
+    }
+    dst.id = streamId;
+    dst.streamType = streamType;
+    dst.width = bufferSet->stream->width;
+    dst.height = bufferSet->stream->height;
+    dst.format = mapToPixelFormat(bufferSet->stream->format);
+    dst.usage = mapToConsumerUsage(cam3stream->getUsage());
+    dst.dataSpace = mapToHidlDataspace(bufferSet->stream->data_space);
+    dst.rotation = mapToStreamRotation((camera3_stream_rotation_t) bufferSet->stream->rotation);
+
+    hidlBufferSet.numBuffers = bufferSet->num_buffers;
+
+    for (size_t i = 0; i < bufferSet->num_buffers; i++) {
+        //these buffer is in the stream buffer, the buffers[] contains the ptrs of handle
+        hidlBufferSet.buffers[i] = *(bufferSet->buffers[i]);
+    }
+
+    auto err = mHidlSession->registerStreamBuffers(hidlBufferSet);
+    if (!err.isOk()) {
+        ALOGE("%s: Transaction error: %s", __FUNCTION__, err.description().c_str());
+        res = DEAD_OBJECT;
+    } else {
+        res = CameraProviderManager::mapToStatusT(err);
+    }
+
+    return res;
+}
