diff --git a/camera/device/3.2/default/CameraDeviceSession.cpp b/camera/device/3.2/default/CameraDeviceSession.cpp
--- a/camera/device/3.2/default/CameraDeviceSession.cpp
+++ b/camera/device/3.2/default/CameraDeviceSession.cpp
@@ -1215,8 +1215,23 @@ void CameraDeviceSession::sProcessCaptureResult(
     CaptureResult result;
     result.frameNumber = frameNumber;
     result.fmqResultSize = 0;
-    result.partialResult = hal_result->partial_result;
-    convertToHidl(hal_result->result, &result.result);
+
+    // Legacy Tegra HAL may emit malformed partial_result counters and
+    // metadata payloads that crash conversion in 8.1 camera interfaces.
+    // Keep callback/buffer flow alive but drop metadata for malformed
+    // partial callbacks.
+    bool malformedPartial =
+            (hal_result->partial_result == 0 || hal_result->partial_result > 16);
+    if (malformedPartial) {
+        result.partialResult = 0;
+    } else {
+        result.partialResult = hal_result->partial_result;
+        convertToHidl(hal_result->result, &result.result);
+    }
+
+    if (malformedPartial) {
+        goto done_result_overrides;
+    }

     if (nullptr != hal_result->result) {
         bool resultOverriden = false;
         Mutex::Autolock _l(d->mInflightLock);
@@ -1265,6 +1280,8 @@ void CameraDeviceSession::sProcessCaptureResult(
            }
        }
     }
+
+done_result_overrides:
